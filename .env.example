# Variables de docker-compose.yaml. Copia este archivo como `.env` (queda fuera de git).

# --- Túnel de Cloudflare (perfil `tunnel`) ---
# Token de tu túnel: Zero Trust → Networks → Tunnels → tu túnel → Configure → token.
# En el panel, el hostname público debe apuntar a  http://backend:8080
TUNNEL_TOKEN=

# --- CORS: quién puede llamar a la API desde el navegador ---
# Tu dominio de Vercel (sin barra final). Varios, separados por coma.
AURA_CORS_ORIGINS=https://tu-proyecto.vercel.app
# Opcional: previsualizaciones de Vercel
AURA_CORS_ORIGIN_REGEX=

# --- Ollama ---
# El modelo y el resto del agente (AURA_OLLAMA_MODEL, AURA_OLLAMA_REASONING, AURA_OLLAMA_NUM_CTX…) se leen de
# src/backend/.env (el mismo archivo que usa el backend sin Docker). No los repitas aquí.
# Solo si usas `--profile ollama` (Ollama dentro de Docker), descomenta:
# AURA_OLLAMA_URL=http://ollama:11434
# Por defecto se usa el Ollama de tu PC (host.docker.internal:11434).

# --- Data Pack ---
# Carpeta del Data Pack en tu PC (por defecto ./src/backend/data_pack)
# AURA_DATA_HOST_DIR=C:/ruta/al/DataPack
