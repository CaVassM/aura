# Copia este archivo como .env (queda fuera de git) y ajusta lo que necesites.
# Todas las variables son opcionales: estos son los valores por defecto.

# Modelo de Ollama: el nombre exacto que ves en `ollama list`
AURA_OLLAMA_MODEL=gemma4
AURA_OLLAMA_URL=http://localhost:11434
AURA_OLLAMA_TEMPERATURE=0.2
# Ventana de contexto (tokens). El valor por defecto de Ollama es corto para prompt + herramientas.
AURA_OLLAMA_NUM_CTX=8192
# Segundos que se espera una respuesta del modelo
AURA_OLLAMA_TIMEOUT=120
# «Pensar» antes de responder: false = apagado (mucho más rápido), true = encendido.
# Déjalo vacío para usar lo que haga el modelo por defecto. Solo aplica a modelos con modo de razonamiento (p. ej. Qwen3).
AURA_OLLAMA_REASONING=
# Cuánto tiempo queda el modelo cargado en memoria sin usarse (evita la espera de recargarlo)
AURA_OLLAMA_KEEP_ALIVE=30m

# Llamadas al modelo/herramientas por mensaje antes de rendirse, y mensajes recordados por conversación
AURA_AGENTE_MAX_PASOS=10
AURA_AGENTE_MAX_TURNOS=12

# Línea de ayuda propia de la red, que se nombra en el mensaje de crisis (texto libre, p. ej. "la Línea de Bienestar 0800-000").
# Si queda vacío, el mensaje dice «la línea de ayuda de tu institución». No pongas aquí líneas de un país real si la red es ficticia.
AURA_LINEA_AYUDA=
